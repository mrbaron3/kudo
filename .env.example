# 開発用の非機密 example configuration。次を実行してから docker compose を使う。
#
#   cp .env.example .env
#
# .env は git 管理外である。ここには開発専用の非機密値だけを置き、secret を書かない。
# production の credential は Compose secrets / *_FILE 方式で扱う（docs/runtime-platform.md）。
KUDO_POSTGRES_USER=kudo
KUDO_POSTGRES_PASSWORD=kudo-dev-password
KUDO_POSTGRES_DB=kudo
