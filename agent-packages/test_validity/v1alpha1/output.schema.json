{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kudo.agent-output/test_validity/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verdict", "findings"],
  "properties": {
    "schema": {
      "const": "kudo.agent-output/test_validity/v1alpha1"
    },
    "verdict": {
      "enum": ["approve", "request_changes", "needs_human"]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "expected", "observed", "evidenceRefs"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "severity": {
          "enum": ["blocking", "advisory"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "observed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  }
}
